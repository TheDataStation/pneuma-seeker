APP_VERSION=v0.0.1

OPENAI_API_KEY=TODO
GEMINI_API_KEY=TODO
ANTHROPIC_API_KEY=TODO

USE_AZURE_LLM=false
USE_AZURE_EMBED_MODEL=false

LLM_PATH=gpt-6-luna
# Optional; unset sends no temperature (some models accept only their default)
# LLM_TEMPERATURE=0

ADMIN_EMAIL=pneuma_admin@pneuma.com
ADMIN_PASSWORD=admin_password

ENABLE_WEB_SEARCH=false
ENABLE_WEB_CRAWL=false
ENABLE_MULTI_DATASET=true

# Table Retrieve over internal tables: m1 | pneuma_retriever
TABLE_DISCOVERY_METHOD=m1
# Tribal knowledge, per information need: m1 | bm25
TRIBAL_KNOWLEDGE_RETRIEVAL_METHOD=m1
# Entries per need for bm25, and m1's fallback if a classifier call fails
TRIBAL_KNOWLEDGE_RETRIEVAL_TOP_K=10

# Datasets: uploads are stored as <DATASETS_ROOT>/<dataset>/<table>/<table>.parquet
# (default: src/pneuma_seeker/services/db/datasets/_data). Max size of one uploaded file, in bytes.
# DATASETS_ROOT=
# UPLOAD_MAX_BYTES=5368709120
# Host folder mounted read-only at /data for the folder and file connectors (docker-compose).
# CONNECTOR_DATA_DIR=./data_src

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pneuma_users
POSTGRES_USER=pneuma
POSTGRES_PASSWORD=pneuma_password
