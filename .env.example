APP_VERSION=v0.0.1

OPENAI_API_KEY=TODO
GEMINI_API_KEY=TODO
ANTHROPIC_API_KEY=TODO

USE_AZURE_LLM=false
USE_AZURE_EMBED_MODEL=false

LLM_PATH=o4-mini

ADMIN_EMAIL=pneuma_admin@pneuma.com
ADMIN_PASSWORD=admin_password

ENABLE_WEB_SEARCH=false
ENABLE_WEB_CRAWL=false
ENABLE_MULTI_DATASET=true

# Table Retrieve over internal tables: pneuma_retriever | m1
TABLE_DISCOVERY_METHOD=pneuma_retriever
# Tribal knowledge, per information need: m1 | bm25
TRIBAL_KNOWLEDGE_RETRIEVAL_METHOD=m1
# Entries per need for bm25, and m1's fallback if a classifier call fails
TRIBAL_KNOWLEDGE_RETRIEVAL_TOP_K=10

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pneuma_users
POSTGRES_USER=pneuma
POSTGRES_PASSWORD=pneuma_password
