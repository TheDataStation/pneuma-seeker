APP_VERSION=v0.0.1

OPENAI_API_KEY=TODO
GEMINI_API_KEY=TODO
ANTHROPIC_API_KEY=TODO

USE_AZURE_LLM=false
USE_AZURE_EMBED_MODEL=false

LLM_PATH=o4-mini

ADMIN_EMAIL=pneuma_admin@pneuma.com
ADMIN_PASSWORD=admin_password

ENABLE_WEB_SEARCH=false
ENABLE_WEB_CRAWL=false

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pneuma_users
POSTGRES_USER=pneuma
POSTGRES_PASSWORD=pneuma_password

# "local" (default): identity (users/groups/permissions/tokens) lives in
# this service's own Postgres above, exactly as before this setting
# existed — leave everything below unset/commented for normal operation.
# "external": delegate identity to Agentic Catalog's own identity
# subsystem instead — see the migration plan before ever setting this.
# AUTH_BACKEND=external
# AUTH_BACKEND_EXTERNAL_URL=http://host.docker.internal:8001/api/auth
# Must match AGENTIC_CATALOG_SERVICE_TOKEN in Agentic Catalog's own .env
# exactly. Required (and validated at startup) whenever AUTH_BACKEND=external.
# AGENTIC_CATALOG_SERVICE_TOKEN=
